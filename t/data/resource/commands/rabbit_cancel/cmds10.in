match allocate @TEST_SRCDIR@/data/resource/jobspecs/dyn_explore/test001.yaml
find sched-now=allocated
remove 17 false
find sched-now=allocated
find jobid-tag=1
find jobid-alloc=1
cancel 1
find sched-now=allocated
find jobid-tag=1
find jobid-alloc=1
match allocate @TEST_SRCDIR@/data/resource/jobspecs/dyn_explore/test001.yaml
quit
